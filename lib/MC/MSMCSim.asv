function [SVReturn] = MSMCSim(lidarCfg, cloudCfg, varargin)
% MSMCSIM Multiple-Scattering with Monte-Carlo method.
%
% USAGE:
%    [SVReturn] = MSMCSim(lidarCfg, cloudCfg)
%
% INPUTS:
%    lidarCfg: struct
%        lambda: incident wavelength. [nm]
%        rBeam: radius of laser beam at z=0. [mm]
%        divBeam: divergence of laser beam. [mrad]
%        FOV: field of view. [mrad]
%        rTel: radius of receiving telescope. [mm]
%        binWidth: bin width. [ns]
%        nBins: number of range bins.
%        distBeamTel: distance between laser axis and optics axis of receiving telescope. [mm]
%        SBeam: Stokes vector of the incident laser beam.
%    cloudCfg: struct
%        clBase: cloud base height. [m]
%        clDh: geometrical thickness of each cloud layer. [m]
%        nClLayers: number of cloud layers.
%        kappa: shape factor of modified gamma distribution.
%        clExt: cloud extinction. [m-1]
%        clReff: cloud droplet effective radius. [um]
%
% KEYWORDS:
%    nPhoton: numeric
%        number of photons to be simulated. (default: 1e4)
%    visible: char
%        'on' | 'off'
%    debug: char
%
% OUTPUTS:
%    SVReturn:
%        4 * nBins [I, Q, U, V] at each range gate.
%
% HISTORY:
%    2023-06-05: first edition by Zhenping
% .. Authors: - zp.yin@whu.edu.cn

p = inputParser;
p.KeepUnmatched = true;

addRequired(p, 'lidarCfg', @isstruct);
addRequired(p, 'cloudCfg', @isstruct);
addParameter(p, 'nPhoton', 1e4, @isnumeric);
addParameter(p, 'visible', 'on', @ischar);
addParameter(p, 'debug', false, @islogical);

parse(p, lidarCfg, cloudCfg, varargin{:});

%% Parameter Definition
nPhotons = p.Results.nPhoton;

%% Cloud Scattering Properties
projectDir = fileparts(fileparts(fileparts(mfilename('fullpath'))));
clScatMatrixFile = fullfile(projectDir, 'data', 'water_cloud_scattering_phase_function_example.mat');
cloudScatMatrix = cloudScatteringMatrix(lidarCfg.lambda, clScatMatrixFile, 'cloud_distribution', 'modified-gamma', 'kappa', cloudCfg.kappa, 'sigma_e', cloudCfg.clExt, 'R_eff', cloudCfg.clReff);
muExt = cloudScatMatrix.muExt;
muSca = cloudScatMatrix.muSca;
albedo = muSca ./ muExt;
S11 = cloudScatMatrix.S11;
S12 = cloudScatMatrix.S12;
S33 = cloudScatMatrix.S33;
S34 = cloudScatMatrix.S34;

% Cloud Boundary
% Usually bound corresponding to an optical depth of 2, according to DM Winker and LR Poole, "Monte-Carlo calculations of cloud returns for ground-based and space-based lidars," Applied Physics B 60 (4), 341-344 (1995).   
% Note: we set 4.
clBoundX = 4.0 ./ muExt;
clBoundY = 4.0 ./ muExt;

%% Monte-Carlo Simulation
pPos = zeros(3, nPhotons);   % position of photon
pDir = zeros(3, nPhotons);   % transmit direction of photon
pScaDir = zeros(3, nPhotons);   % transmit direction of photon
SVIn = zeros(4, nPhotons);
len = zeros(1, nPhotons);   % transmit length
SVReturn = zeros(4, lidarCfg.nBins, nPhotons);   % Stokes Vector of return signal
nScas = zeros(1, nPhotons);   % number of scattering events for each photon
isInMedium = true(1, nPhotons);
isAlive = true(1, nPhotons);
rCl = lidarCfg.rBeam * 1e-3 + lidarCfg.divBeam * 1e-3 / 2 * cloudCfg.clBase * 1e-3;   % radius of laser beam at cloud base
ds = zeros(1, nPhotons);
scaClLayer = NaN(1, nPhotons);
scaAng = zeros(1, nPhotons);
rotAng1 = zeros(1, nPhotons);
rotAng2 = zeros(1, nPhotons);
iAng = zeros(1, nPhotons);
probEnter = zeros(1, nPhotons);
SVTemp1 = zeros(4, nPhotons);
SVTemp2 = zeros(4, nPhotons);
iBin = zeros(1, nPhotons);
temp = zeros(5, nPhotons);
for iPhoton = 1:nPhotons

    % launch to cloud base
    isAlive(iPhoton) = true;
    pPos(1, iPhoton) = rand(1, 1) * rCl;
    pPos(2, iPhoton) = rand(1, 1) * rCl;
    pPos(3, iPhoton) = cloudCfg.clBase;
    while (norm(pPos(1:2, iPhoton), 2) > rCl)
        % generate photon according to initial distribution of photons
        pPos(1, iPhoton) = rand(1, 1) * rCl;
        pPos(2, iPhoton) = rand(1, 1) * rCl;
    end
    pDir(:, iPhoton) = pPos(:, iPhoton) / norm(pPos(:, iPhoton) - [0; 0; 0], 2);
    SVIn(:, iPhoton) = rotSVPhi(lidarCfg.SBeam, atan(pDir(2, iPhoton) / pDir(1, iPhoton)));

    while (isAlive(iPhoton))

        % move to the next point
        [pPos(:, iPhoton), isInMedium(iPhoton), ds(iPhoton), scaClLayer(iPhoton)] = freeRunning(pPos(:, iPhoton), pDir(:, iPhoton), muExt, cloudCfg.clDh, cloudCfg.clBase, clBoundX, clBoundY);
        len(iPhoton) = len(iPhoton) + ds(iPhoton);

        % still in the cloud?
        if (isInMedium(iPhoton))

            if (rand(1, 1) > albedo(scaClLayer(iPhoton)))
                % if the photon was absorbed
                isAlive(iPhoton) = false;
                break;
            end

            % whether the photon was still in the FOV
            if (sqrt((pPos(1, iPhoton) - lidarCfg.distBeamTel * 1e-3)^2 + pPos(2, iPhoton)^2) < ((lidarCfg.FOV * 1e-3 * pPos(3, iPhoton) + lidarCfg.rTel * 1e-3 * 2) / 2))
                % Force scattering into the FOV (semi-analytic method)
                pScaDir(:, iPhoton) = [lidarCfg.distBeamTel * 1e-3; 0; 0] - pPos(:, iPhoton);
                pScaDir(:, iPhoton) = pScaDir(:, iPhoton) / norm(pScaDir(:, iPhoton), 2);

                % scattering rotation angle
                [scaAng(iPhoton), rotAng1(iPhoton), rotAng2(iPhoton)] = scaRotAng(pPos(:, iPhoton), pScaDir(:, iPhoton));

                % probability without scattering again until entering lidar FOV
                [~, iAng(iPhoton)] = min(abs(cloudScatMatrix.theta - scaAng(iPhoton) / pi * 180));
                if cloudScatMatrix.theta(iAng(iPhoton)) < 90
                    probEnter(iPhoton) = 0;
                else
                    probEnter(iPhoton) = albedo(scaClLayer(iPhoton)) * pi * (lidarCfg.rTel * 1e-3)^2 / norm(pPos(:, iPhoton) - [lidarCfg.distBeamTel * 1e-3; 0; 0], 2).^2 * exp(- ((pPos(3, iPhoton) - cloudCfg.clBase) * muExt(scaClLayer(iPhoton))) / abs(pScaDir(3, iPhoton))) * S11(scaClLayer(iPhoton), iAng(iPhoton));
                end

                % Stokes vector after scattering
                SVTemp1(:, iPhoton) = rotSVPhi(SVIn(:, iPhoton), rotAng1(iPhoton));
                SVTemp2(:, iPhoton) = [S11(scaClLayer(iPhoton), iAng(iPhoton)), S12(scaClLayer(iPhoton), iAng(iPhoton)), 0, 0; ...
                           S12(scaClLayer(iPhoton), iAng(iPhoton)), S11(scaClLayer(iPhoton), iAng(iPhoton)), 0, 0; ...
                           0, 0, S33(scaClLayer(iPhoton), iAng(iPhoton)), S34(scaClLayer(iPhoton), iAng(iPhoton)); ...
                           0, 0, -S34(scaClLayer(iPhoton), iAng(iPhoton)), S33(scaClLayer(iPhoton), iAng(iPhoton))] * ...
                            SVTemp1(:, iPhoton) / S11(scaClLayer(iPhoton), iAng(iPhoton));

                iBin(iPhoton) = ceil((len(iPhoton) + (pPos(3, iPhoton) - cloudCfg.clBase) / abs(pScaDir(3, iPhoton))) / 3e8 / (lidarCfg.binWidth * 1e-9));
                if iBin(iPhoton) <= lidarCfg.nBins
                    SVReturn(:, iBin(iPhoton), iPhoton) = SVReturn(:, iBin(iPhoton), iPhoton) + transpose(rotSVPhi(rotSVPhi(SVTemp2(:, iPhoton), -rotAng2(iPhoton)), atan(pScaDir(2, iPhoton) / pScaDir(1, iPhoton))) * probEnter(iPhoton) * 2^(nScas(iPhoton) - 1));
                end

                SVIn(:, iPhoton) = SVIn(:, iPhoton) * (1 - probEnter(iPhoton));

            end

            % Scattering
            rotAng1(iPhoton) = rand(1, 1) * 2 * pi;
            scaAng(iPhoton) = inverseSampling(cloudScatMatrix.theta, ...
                S11(scaClLayer(iPhoton), :) * SVIn(1, iPhoton) + S12(scaClLayer(iPhoton), :) * (SVIn(2) * cos(2 * rotAng1(iPhoton)) + SVIn(3, iPhoton) * sin(2 * rotAng1(iPhoton))), ...
                1) / 180 * pi;

            % Stokes vector of scattered nPhotons
            [~, iAng(iPhoton)] = min(abs(cloudScatMatrix.theta - scaAng(iPhoton) / pi * 180));
            pScaDir(:, iPhoton) = updateDir(pDir(:, iPhoton), rotAng1(iPhoton), scaAng(iPhoton));
            SVTemp1(:, iPhoton) = rotSVPhi(SVIn(:, iPhoton), rotAng1(iPhoton));
            SVTemp2(:, iPhoton) = [S11(scaClLayer(iPhoton), iAng(iPhoton)), S12(scaClLayer(iPhoton), iAng(iPhoton)), 0, 0; ...
                       S12(scaClLayer(iPhoton), iAng(iPhoton)), S11(scaClLayer(iPhoton), iAng(iPhoton)), 0, 0; ...
                       0, 0, S33(scaClLayer(iPhoton), iAng(iPhoton)), S34(scaClLayer(iPhoton), iAng(iPhoton)); ...
                       0, 0, -S34(scaClLayer(iPhoton), iAng(iPhoton)), S33(scaClLayer(iPhoton), iAng(iPhoton))] * ...
                       SVTemp1(:, iPhoton) / S11(scaClLayer(iPhoton), iAng(iPhoton));
            temp(1, iPhoton) = sqrt((1 - cos(scaAng(iPhoton))^2) * (1 - pScaDir(3, iPhoton)^2));
            if abs(temp(1, iPhoton)) < 1e-8
                temp(2, iPhoton) = pi / 2;
            else
                temp(3, iPhoton) = (double((rotAng1(iPhoton) > pi) && (rotAng1(iPhoton) < 2*pi)) - 0.5) * 2 * (pScaDir(3, iPhoton) * cos(scaAng(iPhoton)) - pDir(3, iPhoton)) / temp(1, iPhoton);
                temp(3, iPhoton) = double(temp(3, iPhoton) <= -1) * -1 + ...
                                   double(temp(3, iPhoton) >= 1) * 1 + ...
                                   double((temp(3, iPhoton) > -1) && (temp(3, iPhoton) < 1)) * temp(3, iPhoton);
                temp(2, iPhoton) = acos(temp(3, iPhoton));
            end

            SVIn(:, iPhoton) = rotSVPhi(SVTemp2(:, iPhoton), -temp(2, iPhoton));   % rotate meridian plane
            nScas(iPhoton) = nScas(iPhoton) + 1;
            pDir(:, iPhoton) = pScaDir(:, iPhoton);
        else
            isAlive(iPhoton) = false;

            if p.Results.debug
                fprintf('Finished %6.2f%%: Photon %d is dead\n', iPhoton/ nPhotons * 100, iPhoton);
            end
        end

    end
end

SVReturn = squeeze(sum(SVReturn, 3));

%% Display
if strcmp(p.Results.visible, 'on')
    figure('Color', 'w');

    subplot(311);

    histogram(nScas);

    subplot(312);

    hold on;
    plot((1:lidarCfg.nBins) * lidarCfg.binWidth * 0.15, SVReturn(1, :));
    plot((1:lidarCfg.nBins) * lidarCfg.binWidth * 0.15, SVReturn(2, :));
    plot((1:lidarCfg.nBins) * lidarCfg.binWidth * 0.15, SVReturn(3, :));
    plot((1:lidarCfg.nBins) * lidarCfg.binWidth * 0.15, SVReturn(4, :));
    xlim([0, lidarCfg.nBins * lidarCfg.binWidth * 0.15]);
    set(gca, 'YScale', 'log');

    subplot(313);
    depRatio = (SVReturn(1, :) - SVReturn(2, :)) ./ (SVReturn(1, :) + SVReturn(2, :));
    %depRatio = (SVReturn(1, :) + SVReturn(4, :)) ./ (SVReturn(1, :) - SVReturn(4, :));
    plot((1:lidarCfg.nBins) * lidarCfg.binWidth * 0.15, depRatio);

    ylim([0, 1]);
    xlim([0, lidarCfg.nBins * lidarCfg.binWidth * 0.15]);
end

end